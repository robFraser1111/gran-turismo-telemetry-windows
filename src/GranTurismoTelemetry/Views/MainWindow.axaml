<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GranTurismoTelemetry.ViewModels"
        xmlns:views="using:GranTurismoTelemetry.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="GranTurismoTelemetry.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/gran-telemetry.ico"
        Title="Gran Telemetry"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="560"
        WindowState="Maximized"
        Background="{StaticResource PageBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Find PS5" Command="{Binding FindPs5Command}"/>
                <MenuItem Header="_Connect to IP" Command="{Binding OpenConnectIpCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Simple" ToggleType="Radio" GroupName="HudMode"
                          IsChecked="{Binding IsSimpleChip, Mode=OneWay}"
                          Command="{Binding SetHudModeCommand}" CommandParameter="Simple"/>
                <MenuItem Header="_Driving" ToggleType="Radio" GroupName="HudMode"
                          IsChecked="{Binding IsDrivingChip, Mode=OneWay}"
                          Command="{Binding SetHudModeCommand}" CommandParameter="Driving"/>
                <MenuItem Header="_Pit wall" ToggleType="Radio" GroupName="HudMode"
                          IsChecked="{Binding IsPitWallChip, Mode=OneWay}"
                          Command="{Binding SetHudModeCommand}" CommandParameter="PitWall"/>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="Open debug…" Command="{Binding OpenDebugCommand}"/>
            </MenuItem>
        </Menu>

        <Panel>
            <views:SideMonitorView IsVisible="{Binding IsSideMonitor}"/>
            <views:PitWallView IsVisible="{Binding IsPitWall}"/>
            <views:SimpleView IsVisible="{Binding IsSimple}"/>
            <views:DebugWindow IsVisible="{Binding ShowDebug}"/>
            <views:ConnectIpWindow IsVisible="{Binding ShowConnectIp}"/>
        </Panel>
    </DockPanel>
</Window>
