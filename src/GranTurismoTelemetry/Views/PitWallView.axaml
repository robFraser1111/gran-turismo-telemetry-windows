<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GranTurismoTelemetry.ViewModels"
             xmlns:models="using:GranTurismoTelemetry.Models"
             xmlns:ctrl="using:GranTurismoTelemetry.Controls"
             x:Class="GranTurismoTelemetry.Views.PitWallView"
             x:DataType="vm:MainViewModel">
    <DockPanel Background="{StaticResource PageBrush}">
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource CyanBrush}"/>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,10" Height="52">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="{Binding LivePillBackground}" CornerRadius="11"
                        Padding="14,3" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LiveBadgeText}" FontSize="11" FontWeight="Bold" LetterSpacing="1"
                               Foreground="{Binding LivePillForeground}"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="Pit wall" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TrackName}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="16" ColumnDefinitions="*,12,0.95*">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Classes="Card" Height="140">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="DELTA TRACE VS SESSION BEST" Margin="0,0,0,8"/>
                            <ctrl:TraceLineControl Values="{Binding DeltaTrace}" Stroke="{StaticResource CyanBrush}"
                                                   Thickness="2" ShowZeroLine="True" CenterZero="True"/>
                        </DockPanel>
                    </Border>

                    <Border Classes="Card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="GEAR / SPEED" Margin="0,0,0,8"/>
                            <Grid ColumnDefinitions="Auto,16,*">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="Caps" Text="GEAR"/>
                                    <TextBlock Text="{Binding GearDisplay}" FontSize="42" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,-4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Classes="Caps" Text="SPEED"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding SpeedText}" FontSize="32" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding SpeedUnit}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                    </StackPanel>
                                    <ctrl:RpmStripControl Height="8" Fraction="{Binding RpmFraction}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Classes="Card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="THIS SESSION" Margin="0,0,0,8"/>
                            <Grid ColumnDefinitions="*,*,*">
                                <StackPanel>
                                    <TextBlock Classes="Caps" Text="LAST"/>
                                    <TextBlock Text="{Binding LastLapValue}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="Caps" Text="BEST"/>
                                    <TextBlock Text="{Binding BestLapValue}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource GreenBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="Caps" Text="LAPS IN MEMORY"/>
                                    <TextBlock Text="{Binding LapsInMemoryText}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Classes="Card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="TIRE TEMPS" Margin="0,0,0,8"/>
                            <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto">
                                <Border Classes="Well" Padding="8,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="FL" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TireFLC}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding TireFLBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Classes="Well" Grid.Column="2" Padding="8,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="FR" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TireFRC}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding TireFRBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Classes="Well" Grid.Row="2" Padding="8,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="RL" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TireRLC}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding TireRLBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Classes="Well" Grid.Row="2" Grid.Column="2" Padding="8,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="RR" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TireRRC}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding TireRRBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Classes="Card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="Caps" Text="DELTA VS SESSION BEST" Margin="0,0,0,8"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2">
                                <TextBlock Text="{Binding LastLapText}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding BestLapText}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DeltaText}" FontSize="32" FontWeight="Bold"
                                       Foreground="{Binding DeltaBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Classes="Card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="Caps" Text="FUEL — THIS SESSION"/>
                            <TextBlock Text="{Binding FuelPercentText}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <ctrl:FuelBarControl Height="12" Percent="{Binding FuelPercent}"/>
                            <TextBlock Text="{Binding FuelPerLapText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding FuelLapsRemainingText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding PredictedStopsText}" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Classes="Card">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Classes="Caps" Text="THIS SESSION — LAST 8 LAPS"/>
                        <TextBlock Text="{Binding BestLapText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RecentLapRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LapRow">
                                <Border Height="36" CornerRadius="6" Padding="8,0" Margin="0,2"
                                        Background="{Binding RowBackground}"
                                        BorderBrush="{Binding RowBorderBrush}"
                                        BorderThickness="{Binding RowBorderThickness}">
                                    <Grid ColumnDefinitions="48,*,80">
                                        <TextBlock Text="{Binding NumberLabel}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="16"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DeltaLabel}" FontSize="12"
                                                   FontWeight="Bold" Foreground="{Binding DeltaBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
